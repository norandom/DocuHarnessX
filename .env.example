# Copy to `.env` and fill in. `.env` is gitignored and loaded by `dhx` at start.
# Existing process environment variables always win over this file.

# DeepSeek (OpenAI-compatible). `dhx` uses the native OpenAI provider whenever
# OPENAI_API_KEY is set; OPENAI_API_BASE must point at DeepSeek or the default
# model id will be sent to api.openai.com.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_DEFAULT_MAIN_MODEL=deepseek-v4-flash

# Optional knobs
# OPENAI_MAX_TOKENS=16384
# DHX_WRITER_TOKEN_BUDGET=400000
# DHX_WRITER_MAX_COST_USD=2.00
# DHX_WRITER_MAX_STEPS=24
# DHX_DEBUG_AGENT=1
